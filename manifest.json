{
  "manifest_version": 3,
  "name": "TradeSight AI - Institutional Chart & Trade Intelligence",
  "version": "1.0.0",
  "description": "30-year veteran technical analysis & vision AI engine for TradingView charts. Risk-first trade setups, multi-timeframe structure, and automated overlay drawings.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "action": {
    "default_title": "Open TradeSight AI Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*",
        "https://*.tradingview.com/chart*",
        "https://*.tradingview.com/symbols/*"
      ],
      "js": [
        "content/chart-detector.js",
        "content/overlay-renderer.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
